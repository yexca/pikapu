# Copy to .env beside docker-compose.yml. Every value is optional; shell
# environment variables take precedence over .env. After changing a value,
# run `docker compose up -d` to recreate the container (a restart alone does
# not apply new environment values).

# Image tag built by `docker compose up --build`, or a published image such
# as yexca/pikapu:0.1 to run with `docker compose pull && docker compose up -d`.
PIKAPU_IMAGE=pikapu:latest

# Host port for the web app and API. The container always listens on 7660.
PIKAPU_PORT=7660

# Optional: create the admin account on first start. Without these, Pikapu
# prints a one-time setup token to the log (`docker compose logs pikapu`) and
# you create the account in the browser. Ignored once the account exists;
# change the username and password in Settings afterwards.
PIKAPU_ADMIN_USERNAME=admin
PIKAPU_ADMIN_PASSWORD=

# Reverse proxies allowed to set X-Forwarded-For, as IPs or CIDR ranges,
# e.g. 172.16.0.0/12 for a proxy container on a Docker network. Pikapu uses
# the client address to rate-limit sign-in attempts.
PIKAPU_TRUSTED_PROXIES=

# production (default) requires sign-in. development turns sign-in off for
# local previews; never use it on an instance others can reach.
PIKAPU_MODE=production

# Time zone for log timestamps, e.g. Asia/Shanghai. Stored dates are UTC.
TZ=UTC
