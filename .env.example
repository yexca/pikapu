# Copy to .env beside docker-compose.yml. Every value is optional; shell
# environment variables take precedence over .env. After changing a value,
# run `docker compose up -d` to recreate the container (a restart alone does
# not apply new environment values).

# Image tag built by `docker compose up --build`.
PIKAPU_IMAGE=pikapu:latest

# Host port for the web app and API. The container always listens on 7660.
PIKAPU_PORT=7660

# Require this password to use the app. Leave empty to disable sign-in.
# Strongly recommended whenever the port is reachable beyond your own machine.
PIKAPU_PASSWORD=

# Time zone for log timestamps, e.g. Asia/Shanghai. Stored dates are UTC.
TZ=UTC
